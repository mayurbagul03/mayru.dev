{
  "name": "mayur-bagul-portfolio",
  "version": "1.0.0",
  "description": "Personal portfolio single-page site with a small Node/Express backend for the contact form.",
  "main": "server.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/style.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/style.css --watch",
    "start": "node server.js",
    "dev": "concurrently \"npm:watch:css\" \"nodemon server.js\""
  },
  "keywords": ["portfolio"],
  "author": "Mayur Bagul",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.4",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13"
  }
}
